# The Hatchery — one .env at the repo root is read by apps/api and apps/chain.
# apps/web has its own apps/web/.env.example (NEXT_PUBLIC_* only).

NODE_ENV=development
LOG_LEVEL=info
CLUSTER=mainnet-beta

# ---- Infra (docker compose up -d postgres redis) --------------------------
DATABASE_URL=postgresql://hpospad:hpospad@localhost:5435/hpospad
REDIS_URL=redis://localhost:6382

# ---- Solana ----------------------------------------------------------------
# Use a real provider (Helius / Triton / QuickNode). The public endpoint will
# throttle backfills and holder snapshots.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional; derived from RPC_URL when unset.
RPC_WS_URL=

# Indexer live source. Set both for Yellowstone gRPC (Helius LaserStream,
# Triton Dragon's Mouth). Unset = RPC websocket logsSubscribe + polling.
GRPC_URL=
GRPC_TOKEN=

# ---- Launchpad config --------------------------------------------------------
# Created once with `pnpm config:create --send`. Every token launches on it.
DBC_CONFIG=
# HPOS10I on Solana: the Wormhole-bridged token (Jupiter verified, legacy SPL,
# 8 decimals, mint authority held by the Wormhole bridge as for any bridged asset).
# Token-2022 quote mints also work (mints with transfer fees or hooks are refused).
# The config can never change quote afterwards: verify before config:create.
QUOTE_MINT=CTgiaZUK12kCcB8sosn4Nt2NZtzLgtPqDwyQyr2syATC
QUOTE_SYMBOL=HPOS10I
QUOTE_DECIMALS=8

# 160 = 1.60% per trade. Meteora keeps a fixed 20% of it (0.32%); the rest
# (1.28%) is split in software:
#   1.60% = 0.75% creator + 0.53% platform + 0.32% Meteora   (no holder reflections)
# TRADE_FEE_BPS is baked into the DBC config (immutable); the split can change later.
# REFLECTION_BPS > 0 turns holder reflections back on (taken from the platform share).
TRADE_FEE_BPS=160
REFLECTION_BPS=0

# Curve, in QUOTE units (used by config:create only): ~$2.4k -> ~$32.6k market cap
# at HPOS10I $0.0163 (2026-09-29); graduation raises ~430k HPOS10I (~$7k, ~15% of
# HPOS10I's ~$47k Solana liquidity). Kept small so curves graduate more easily
# without a big slippage hit on SOL buyers. Recompute from the live price first.
INITIAL_MCAP_QUOTE=150000
MIGRATION_MCAP_QUOTE=2000000
POOL_CREATION_FEE_SOL=0

# ---- Wallets (how to make them: docs/CONFIG.md) --------------------------------
# Partner / fee claimer. Claims fees, pays reflections, migrates graduated
# pools, owns the permanently locked LP. Base58 or JSON byte array.
# Only apps/chain (service + config:create) reads the secret.
FEE_CLAIMER_SECRET_KEY=
# Its public key, for the api (which never holds a secret).
FEE_CLAIMER=
# Receives the platform share (0.53%). Your own wallet, address only; never the fee claimer.
TREASURY=

# ---- Reflections -----------------------------------------------------------------
# The fee job: claims fees, pays creator + platform (and holders if REFLECTION_BPS > 0). Keep on.
REFLECT_ENABLED=true
REFLECT_INTERVAL_MINUTES=5
# Skip a token's epoch until this much quote is claimable.
REFLECT_MIN_CLAIM_QUOTE=200
# Shares below this carry to the next epoch.
REFLECT_MIN_PAYOUT_QUOTE=10
REFLECT_MIN_HOLDING_BPS=1
# Open a HPOS10I account for holders without one (~0.00204 SOL each, paid by the
# fee claimer). Off = those shares carry until the holder has a HPOS10I account.
REFLECT_CREATE_ATAS=false
REFLECT_MAX_ATAS_PER_EPOCH=50
REFLECT_TRANSFERS_PER_TX=10
# Wallets never paid (CEX, team), comma-separated.
REFLECT_EXCLUDE=

# ---- Life watch (rug / dead) -------------------------------------------------
# RUGGED (final) = migrated to DAMM v2 (curve coins are never burned)
#   AND creator sold > RUG_CREATOR_SOLD_BPS of what they bought
#   AND it had traction: >= RUG_MIN_HOLDERS holders and a day with > RUG_MIN_PEAK_VOLUME_USD volume
#   AND it collapsed: no trade for RUG_IDLE_HOURS, or market cap > RUG_ATH_DRAWDOWN_BPS below its ATH.
# DEAD = no trade for DEAD_IDLE_HOURS (revives on the next trade).
RUG_CREATOR_SOLD_BPS=5000
RUG_MIN_HOLDERS=15
RUG_MIN_PEAK_VOLUME_USD=8000
RUG_IDLE_HOURS=6
RUG_ATH_DRAWDOWN_BPS=7000
DEAD_IDLE_HOURS=24
VITALS_MINUTES=5

MIGRATOR_ENABLED=true
HOLDERS_SYNC_MINUTES=5
PRIORITY_FEE_MICROLAMPORTS=50000

# ---- API ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGINS=*
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_MAX_ACCOUNTS=32
# app.pinata.cloud -> API Keys. Needed for /launch/metadata.
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Encrypts vanity mint secrets in the database (openssl rand -hex 32).
VANITY_ENCRYPTION_KEY=
VANITY_SUFFIX=hpos

# Featured tokens on the site, mascot first (comma-separated mints).
FEATURED_MINTS=

# Share of volume paid to each token's creator (bps).
CREATOR_BPS=75

# ---- Claims --------------------------------------------------------------------
# Shared secret between the api and the internal claim signer in chain-service
# (openssl rand -hex 32). Unset = claims disabled.
SIGNER_TOKEN=
# Where the api reaches the signer. Compose: http://chain-service:3002. Local dev: http://localhost:3002.
SIGNER_URL=http://chain-service:3002

# The platform official token, pinned next to the mascot.
OFFICIAL_MINT=

# ---- Web ---------------------------------------------------------------------------
# Pre-launch gate (apps/web/lib/gate.ts): set = every page shows Coming soon until the
# password is entered; empty = site open. Change it, then restart the web container.
SITE_LOCK_PASSWORD=
