{
  "name": "@hpos-pad/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma db push'",
    "db:studio": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma studio'"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@hpos-pad/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.19.2",
    "typescript": "^5.8.0"
  }
}
